# ---------------------------------------------------------------------------
# Smart E-Commerce - environment configuration
# Copy this file to .env in the project root (or server/.env) and fill values.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection used by the backend and the database scripts.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_ecommerce

# Dedicated database used by the automated integration test suite.
# The test preparation script drops and recreates THIS database only.
# The name MUST contain "test" as a safety guard.
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_ecommerce_test

# Backend HTTP port
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# JWT signing secret. Use a long random value (32+ chars) in every environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Cookies. In production set COOKIE_SECURE=true. Use COOKIE_SAMESITE=none only
# when the API and frontend are on different sites (requires HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional: set to true when the PostgreSQL server requires TLS.
DB_SSL=false

# Optional: trusted proxy hops when running behind Nginx/Cloudflare, e.g. 1
TRUST_PROXY=0
